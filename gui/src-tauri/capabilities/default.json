{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-background-color",
    "core:webview:allow-set-webview-background-color",
    "opener:default",
    "store:default",
    "log:default",
    "notification:default",
    "allow-get-games",
    "allow-get-game",
    "allow-get-running-games",
    "allow-save-game",
    "allow-delete-game",
    "allow-untrack-game",
    "allow-create-slot",
    "allow-switch-slot",
    "allow-rename-slot",
    "allow-delete-slot",
    "allow-restore-version",
    "allow-tag-version",
    "allow-set-game-icon",
    "allow-set-game-accent",
    "allow-scan-installed",
    "allow-get-scan-roots",
    "allow-add-scan-root",
    "allow-remove-scan-root",
    "allow-get-monitoring-settings",
    "allow-update-monitoring-settings",
    "allow-screenshots-supported",
    "allow-get-screenshot-path",
    "allow-get-device",
    "allow-update-device",
    "allow-get-sync-settings",
    "allow-update-sync-settings",
    "allow-refresh-sync",
    "allow-adopt-remote-game",
    "allow-apply-remote-version",
    "allow-remove-sync-device",
    "allow-get-retired-versions",
    "allow-get-pruning-settings",
    "allow-update-pruning-settings",
    "allow-preview-pruning",
    "allow-run-pruning",
    "allow-inspect-history-bundle",
    "allow-export-game-history",
    "allow-import-game-history",
    "allow-get-startup-notice",
    "allow-get-recovered-restores",
    "allow-get-prefs-path",
    "allow-pick-folder",
    "allow-pick-file",
    "allow-pick-save-path",
    "allow-confirm",
    "allow-set-tray-labels",
    "allow-set-overlay-config",
    "allow-e2e-tray-labels"
  ]
}

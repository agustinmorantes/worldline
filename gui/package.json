{
  "name": "worldline",
  "private": true,
  "version": "1.0.0-rc1",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "bun run ../.husky/install.mts",
    "check": "eslint . && tsc --noEmit && tsc --noEmit -p tests/e2e",
    "test": "vitest",
    "test:screens": "playwright test",
    "e2e:build": "tauri build --debug --no-bundle --features e2e",
    "e2e": "wdio run tests/e2e/wdio.conf.ts",
    "bindings": "cd .. && cargo test -p worldline-core --features ts export_bindings",
    "lint": "lint-staged",
    "ci": "eslint --fix && tsc --noEmit && cd src-tauri && cargo clippy",
    "gen-icon": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.133.27",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-log": "~2.9.0",
    "@tauri-apps/plugin-store": "~2.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.548.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.2.3",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/router-plugin": "^1.133.27",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@wdio/cli": "^10.0.1",
    "@wdio/globals": "^10.0.1",
    "@wdio/local-runner": "^10.0.1",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.2.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.1.6"
  }
}
